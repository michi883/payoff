{
  "name": "payoff",
  "private": true,
  "version": "0.1.0",
  "description": "A versioned creator workspace for testing whether a story's emotional payoff lands.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "check": "npm run lint && npm test && npm run build",
    "start": "node dist-server/server.js",
    "configure:production-secrets": "bash scripts/configure-cloud-run-secrets.sh",
    "deploy:production": "npm run check && bash scripts/deploy-cloud-run.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "acceptance:storyboard": "node scripts/storyboard-acceptance.mjs",
    "acceptance:revision": "tsx scripts/revision-acceptance.ts",
    "generate:canonical-assets": "tsx scripts/generate-canonical-assets.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "openai": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5"
  }
}
